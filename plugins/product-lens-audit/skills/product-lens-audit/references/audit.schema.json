{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "product-lens-audit report data",
 "type": "object",
 "required": [
  "lang",
  "text",
  "lenses",
  "ops",
  "detail",
  "plans",
  "sources"
 ],
 "properties": {
  "lang": {
   "type": "string",
   "enum": [
    "uk",
    "en"
   ],
   "description": "Report language; picks interface labels."
  },
  "title": {
   "type": "string",
   "description": "Browser tab title."
  },
  "text": {
   "type": "object",
   "description": "Report's own text. Tokens {health} {qw} {n} {conf} are replaced; [[words]] are highlighted in red. A missing or empty key removes that element.",
   "properties": {
    "label": {
     "type": "string"
    },
    "headline": {
     "type": "string"
    },
    "lead": {
     "type": "string"
    },
    "funnelNote": {
     "type": "string"
    },
    "lensesH": {
     "type": "string"
    },
    "lensesP": {
     "type": "string"
    },
    "journeyH": {
     "type": "string"
    },
    "journeyP": {
     "type": "string"
    },
    "matrixH": {
     "type": "string"
    },
    "matrixP": {
     "type": "string"
    },
    "opsH": {
     "type": "string"
    },
    "opsP": {
     "type": "string"
    },
    "nextH": {
     "type": "string"
    },
    "nextP": {
     "type": "string"
    },
    "planH": {
     "type": "string"
    },
    "planP": {
     "type": "string"
    },
    "dataH": {
     "type": "string"
    },
    "dataP": {
     "type": "string"
    },
    "footer": {
     "type": "string"
    },
    "how": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "kpis": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": [
     "v",
     "l"
    ],
    "properties": {
     "v": {
      "type": "string",
      "description": "Value; may use tokens."
     },
     "l": {
      "type": "string"
     },
     "hot": {
      "type": "boolean"
     },
     "src": {
      "type": "string",
      "description": "Name of the source the number came from; required for literal numbers."
     }
    }
   }
  },
  "funnel": {
   "type": "array",
   "minItems": 2,
   "description": "First item is the base and is not drawn.",
   "items": {
    "type": "object",
    "required": [
     "l",
     "n"
    ],
    "properties": {
     "l": {
      "type": "string"
     },
     "n": {
      "type": [
       "number",
       "null"
      ]
     },
     "hot": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     },
     "sub": {
      "type": "string"
     }
    }
   }
  },
  "leaks": {
   "type": "array",
   "description": "Use instead of funnel when problems are separate rates.",
   "items": {
    "type": "object",
    "required": [
     "l",
     "t"
    ],
    "properties": {
     "l": {
      "type": "string"
     },
     "v": {
      "type": [
       "number",
       "null"
      ]
     },
     "b": {
      "type": [
       "number",
       "null"
      ]
     },
     "t": {
      "type": "number",
      "description": "Proposed target, %."
     },
     "sub": {
      "type": "string"
     }
    }
   }
  },
  "stage": {
   "type": "object",
   "required": [
    "cur",
    "note"
   ],
   "properties": {
    "cur": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    },
    "note": {
     "type": "string"
    }
   }
  },
  "lenses": {
   "type": "array",
   "minItems": 13,
   "maxItems": 13,
   "items": {
    "type": "object",
    "required": [
     "k",
     "i",
     "g",
     "s"
    ],
    "properties": {
     "k": {
      "type": "string",
      "description": "Short label on the radar."
     },
     "n": {
      "type": "string",
      "description": "Longer name in the list."
     },
     "i": {
      "type": "string",
      "enum": [
       "cro",
       "toc",
       "kaizen",
       "jtbd",
       "disc",
       "serv",
       "loop",
       "plg",
       "plat",
       "model",
       "ocean",
       "rel",
       "priv"
      ]
     },
     "g": {
      "type": "string",
      "enum": [
       "opt",
       "disc",
       "grow",
       "game",
       "prot"
      ]
     },
     "s": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     }
    }
   }
  },
  "route": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "t",
     "w",
     "st",
     "p"
    ],
    "properties": {
     "t": {
      "type": "string"
     },
     "w": {
      "type": "string"
     },
     "st": {
      "type": "string",
      "enum": [
       "ok",
       "warn",
       "bad"
      ]
     },
     "p": {
      "type": "string"
     }
    }
   }
  },
  "ops": {
   "type": "array",
   "minItems": 1,
   "description": "Opportunity ids are 1-based positions in this array.",
   "items": {
    "type": "object",
    "required": [
     "t",
     "l",
     "ln",
     "x",
     "ev",
     "I",
     "C",
     "E"
    ],
    "properties": {
     "t": {
      "type": "string"
     },
     "l": {
      "type": "string",
      "enum": [
       "cro",
       "toc",
       "kaizen",
       "jtbd",
       "disc",
       "serv",
       "loop",
       "plg",
       "plat",
       "model",
       "ocean",
       "rel",
       "priv"
      ]
     },
     "ln": {
      "type": "string"
     },
     "x": {
      "type": "string",
      "enum": [
       "opt",
       "ex"
      ]
     },
     "ev": {
      "type": "string",
      "enum": [
       "obs",
       "hyp"
      ]
     },
     "I": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     },
     "C": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     },
     "E": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     }
    }
   }
  },
  "plans": {
   "type": "object",
   "description": "Keyed by opportunity id; required for the top 3 by ICE.",
   "additionalProperties": {
    "type": "object",
    "required": [
     "h",
     "m",
     "t"
    ],
    "properties": {
     "h": {
      "type": "string"
     },
     "m": {
      "type": "string"
     },
     "t": {
      "type": "string"
     }
    }
   }
  },
  "detail": {
   "type": "object",
   "description": "Keyed by opportunity id; one per opportunity.",
   "additionalProperties": {
    "type": "object",
    "required": [
     "why",
     "steps",
     "metric",
     "effort",
     "risk"
    ],
    "properties": {
     "why": {
      "type": "string"
     },
     "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "string"
      }
     },
     "metric": {
      "type": "string"
     },
     "effort": {
      "type": "string"
     },
     "risk": {
      "type": "string"
     },
     "alt": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "rtype": {
      "type": "string"
     },
     "thr": {
      "type": "string"
     },
     "pm": {
      "type": "string"
     },
     "copy": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "accept": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Acceptance criteria for the hands-off file. If missing, thr and metric are used."
     },
     "depends": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Task ids this one depends on, e.g. [\"T04\"]."
     },
     "verify": {
      "type": "string",
      "description": "How to check the task is done when it has no plan entry."
     }
    }
   }
  },
  "answers": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "q",
     "a"
    ],
    "properties": {
     "q": {
      "type": "string"
     },
     "a": {
      "type": "string"
     },
     "skipped": {
      "type": "boolean"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "status"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "ok",
       "demo",
       "no"
      ]
     }
    }
   }
  },
  "glossary": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "g",
     "d"
    ],
    "properties": {
     "g": {
      "type": "string"
     },
     "d": {
      "type": "string"
     }
    }
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Optional rules for whoever implements the plan; shown in the hands-off file. Defaults apply when missing."
  }
 }
}